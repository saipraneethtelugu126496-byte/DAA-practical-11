#include <iostream>
using namespace std;
#define INF 99999
int main()
{int n, d[10][10]; 
 cout << "Enter number of vertices: "; 
 cin >> n; 
 cout << "Enter adjacency matrix (99999 for infinity):\n";  for (int i = 0; i < n; i++) 
 for (int j = 0; j < n; j++) 
 cin >> d[i][j]; 
 cout << "\nD0 Matrix:\n"; 
 for (int i = 0; i < n; i++) { 
 for (int j = 0; j < n; j++) 
 cout << d[i][j] << " "; 
 cout << endl; 
 } 
 for (int k = 0; k < n; k++) { 
 for (int i = 0; i < n; i++) { 
 for (int j = 0; j < n; j++) { 
 if (d[i][k] != INF && d[k][j] != INF &&  d[i][k] + d[k][j] < d[i][j]) { 
 d[i][j] = d[i][k] + d[k][j]; 
 } 
 } 
 } 
 cout << "\nD" << k + 1 << " Matrix:\n";  for (int i = 0; i < n; i++) { 
 for (int j = 0; j < n; j++) { 
 if (d[i][j] == INF) 
 cout << "INF ";
 cout << d[i][j] << " "; 
 } 
 cout << endl; 
 } 
 } 
 return 0; 
} 
